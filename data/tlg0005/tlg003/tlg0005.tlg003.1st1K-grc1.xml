   <text xml:lang="grc">
      <body xml:base="urn:cts:greekLit:tlg0005.tlg003.1st1K-grc1">
         <l n="1" resp="ogl">
            <pb facs="bucogr_415773970_0188" />Οὐδενὸς εὐνάτειρα Μακροπτολέμοιο δὲ μάτηρ </l>
         <l n="2" resp="ogl">μαίας ἀντιπέτροιο θοὸν τέκεν ἰθυντῆρα, </l>
         <l n="3" resp="ogl">οὐχὶ Κεράσταν ὅν ποτε θρέψατο ταυροπάτωρ, </l>
         <l n="4" resp="ogl">ἀλλ᾽ ου πειλιπὲς αἶθε πάρος φρένα τέρμα σάκους, </l>
         <l n="5" resp="editor">οὔνομ᾽ Ὅλον, δίζων, ὃς τᾶς μέροπος πόθον </l>
         <l n="6" resp="ogl">κούρας γηρυγόνας ἔχε τᾶς ἀνεμώδεος, </l>
         <l n="7" resp="ogl">ὃς Μοίσᾳ λιγὺ πᾶξεν ἰοστεφάνῳ </l>
         <l n="8" resp="ogl">ἕλκος, ἄγαλμα πόθοιο πυρισμαράγου, </l>
         <l n="9" resp="ogl">ὃς σβέσεν ἀνορέαν ἰσαυδέα </l>
         <l n="10" resp="editor">παπποφόνου Τυρίας τ᾽ ἐ<add>ξήλασεν</add>. </l>
         <l n="11" resp="ogl">ᾧ τόδε τυφλοφόρων ἐρατόν </l>
         <l n="12" resp="ogl">πῆμα Πάρις θέτο Σιμιχίδας· </l>
         <l n="13" resp="ogl">ψυχὰν ᾇ, βροτοβάμων, </l>
         <l n="14" resp="ogl">στήτας οἶστρε Σαέττας, </l>
         <l n="15" resp="editor">κλωποπάτωρ, ἀπάτωρ, </l>
         <l n="16" resp="ogl">λαρνακόγυιε, χαρείς </l>
         <l n="17" resp="ogl">ἁδὺ μελίσδοις </l>
         <l n="18" resp="ogl">ἔλλοπι κούρᾳ, </l>
         <l n="19" resp="ogl">Καλλιόπᾳ </l>
         <l n="20" resp="editor">νηλεύστῳ. </l>
      </body>
   </text>
